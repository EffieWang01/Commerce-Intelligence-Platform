COMMERCE_PROFILE=server
COMMERCE_DATA_DIR=/data/processed
COMMERCE_ARTIFACTS_DIR=/models/artifacts
COMMERCE_LLM_BACKEND=openai-compatible
COMMERCE_LLM_MODEL=qwen-vl-plus
COMMERCE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COMMERCE_LLM_API_KEY=
COMMERCE_EMBEDDING_BACKEND=sentence-transformers
COMMERCE_EMBEDDING_MODEL=BAAI/bge-m3
COMMERCE_VECTOR_BACKEND=qdrant
COMMERCE_QDRANT_URL=http://127.0.0.1:6333
COMMERCE_QDRANT_COLLECTION=commerce_products
COMMERCE_QDRANT_IMAGE_COLLECTION=commerce_product_images
COMMERCE_RECOMMENDATION_BACKEND=gorse
COMMERCE_GORSE_URL=http://127.0.0.1:8088
COMMERCE_RERANKER_BACKEND=cross-encoder
COMMERCE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
COMMERCE_MULTIMODAL_BACKEND=chinese-clip
COMMERCE_MULTIMODAL_MODEL=ViT-B-16
COMMERCE_SYNC_EXTERNAL=false
COMMERCE_CANDIDATE_K=100
COMMERCE_TOP_K=10
COMMERCE_MAX_AGENT_STEPS=4

